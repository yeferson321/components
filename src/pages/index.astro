---
import { resolveLocale, getI18n } from '@/i18n/config';
import Layout from '@/layouts/Layout.astro';
import Welcome from '@/components/Welcome.astro';

import { IconHeart } from 'ui/icons/outline';

import LoginModal from '@/components/LoginModal.astro';

const locale = resolveLocale(Astro.preferredLocale);

const t = await getI18n(locale);
---

<Layout translations={t} locale={locale}>

	<a href="/sofiapalmer">View Profile {Astro.preferredLocale}</a>

	<h2>Main: {t.about.title} locale: {locale}</h2>

	<button type="button" class="p-2.5 rounded-full bg-blue-500/20 hover:bg-blue-500/30 transition-colors duration-300 ease-in-out" data-modal-open="login-modal" aria-label="Abrir modal de inicio de sesión" aria-haspopup="dialog" aria-expanded="false" aria-controls="login-modal">
		<IconHeart stroke-width="2" width="26" height="26" class="stroke-blue-500"/>
	</button>

	<LoginModal translations={t.loginModal} />
	
</Layout>