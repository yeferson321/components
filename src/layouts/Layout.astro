    </div>

		            </div>
		        </div>
		    </div>
		</div>

	</body>
</html>

<script>
    export const appendChildElement = (element: HTMLElement, parent?: HTMLElement) => (parent ?? document.body).appendChild(element);
export const removeElement = (element: HTMLElement) => element.remove();

export const trapFocus = (element: HTMLElement, event: KeyboardEvent) => {
    const focusables = Array.from(
        element.querySelectorAll<HTMLElement>(':is(button, [href], input, select, textarea):not([disabled]):not([aria-hidden="true"])')
    ).filter((HTMLElement) => HTMLElement.offsetParent !== null);

    if (focusables.length === 0) return;

    const firstFocusable = focusables[0];
    const lastFocusable = focusables[focusables.length - 1];
    const boundary = event.shiftKey ? firstFocusable : lastFocusable;

    if (document.activeElement === boundary) {
        event.preventDefault();
        (event.shiftKey ? lastFocusable : firstFocusable).focus();
    }
};
   export type ChangeDetail = { isOpen: boolean };

declare global {
    interface HTMLElementEventMap {
        'modal:change': CustomEvent<ChangeDetail>;
        'sidebar:change': CustomEvent<ChangeDetail>;
    }
    interface WindowEventMap {
        [key: `modal:change:${string}`]: CustomEvent<ChangeDetail>;
        [key: `sidebar:change:${string}`]: CustomEvent<ChangeDetail>;
    }
};

    const setupModal = (modalElement: HTMLDivElement) => {
        const { modalId, unmount } = modalElement.dataset;
        if (!modalId) throw new Error('Missing "data-modal-id" attribute on Modal component');

        const overlayElement = modalElement.querySelector<HTMLDivElement>(".modal-overlay");
        if (!overlayElement) throw new Error(`Modal "${modalId}": component internal element(s) .modal-overlay not found.`);

        unmount === "true" ? removeElement(modalElement) : appendChildElement(modalElement);

        const openButtonElement = document.querySelector<HTMLButtonElement>(`[data-modal-open="${modalId}"]`);
        const closeButtonElement = modalElement.querySelector<HTMLButtonElement>(`[data-modal-close="${modalId}"]`);
        const focusableElement = modalElement.querySelector<HTMLElement>("[data-modal-autofocus]");
        let lastFocusedElement: HTMLElement | null = null;

        const setAccessibility = (isHidden: boolean) => {
            modalElement.dataset.state = isHidden ? "closed" : "open";
            modalElement.setAttribute("aria-hidden", String(isHidden));
            openButtonElement?.setAttribute("aria-expanded", String(!isHidden));

            const detail: ChangeDetail = { isOpen: !isHidden };
            modalElement.dispatchEvent(new CustomEvent('modal:change', { detail }));
            window.dispatchEvent(new CustomEvent(`modal:change:${modalId}`, { detail }));
        };

        const handleKeyboard = (event: KeyboardEvent) => {
            if (event.key === "Escape") return hideModal();
            if (event.key === "Tab") trapFocus(modalElement, event);
        };

        const showModal = () => {
            if (modalElement.dataset.state !== "closed") return;
            // Se guarda antes de abrir, para restaurarlo al cerrar.
            lastFocusedElement = document.activeElement as HTMLElement;

            if (unmount === "true") appendChildElement(modalElement);
            modalElement.dataset.state = "opening";

            // void modalElement.offsetHeight;

            requestAnimationFrame(() => {
                setAccessibility(false);
                modalElement.addEventListener("keydown", handleKeyboard);
                (focusableElement || modalElement).focus();
            });
        };

        const hideModal = () => {
            if (modalElement.dataset.state !== "open") return;

            modalElement.removeEventListener("keydown", handleKeyboard);
            // El foco sale antes de marcar aria-hidden="true".
            lastFocusedElement?.focus();
            modalElement.dataset.state = "closing";

            // Resuelve al instante si no hay animaciones en curso.
            Promise.allSettled(modalElement.getAnimations({ subtree: true }).map(({ finished }) => finished)).then(() => {
                setAccessibility(true);
                if (unmount === "true") removeElement(modalElement);
            });
        };

        overlayElement.addEventListener("click", hideModal);
        openButtonElement?.addEventListener("click", showModal);
        closeButtonElement?.addEventListener("click", hideModal);
        window.addEventListener(`modal:show:${modalId}`, showModal);
        window.addEventListener(`modal:hide:${modalId}`, hideModal);
    };

    document.querySelectorAll<HTMLDivElement>(".modal").forEach(setupModal)
</script>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300..900&family=Righteous&display=swap');

.modal {
    display: none;
    position: relative;
    z-index: 50;
}

.modal:not([data-state="closed"]) {
    display: block;
}

.modal-overlay {
    position: fixed;
    inset: 0px;
    opacity: 0;
    background-color: var(--overlay-color);
    backdrop-filter: blur(1px);
    transition: opacity var(--transition-duration, 300ms) var(--transition-timing, ease-in-out);
}

.modal[data-state="open"] > .modal-overlay { opacity: 1; }

/* No captura clics: así llegan al overlay y solo el panel los recibe. */
.modal-wrapper {
    position: fixed;
    inset: 0px;
    z-index: 50;
    width: 100vw;
    overflow-y: auto;
    pointer-events: none;
}

.modal-positioner {
    display: flex;
    justify-content: center;
    align-items: var(--align-items);
    padding: var(--offset);
    min-height: 100%;
}

.modal[data-vertical="top"] .modal-positioner { --align-items: flex-start; }
.modal[data-vertical="center"] .modal-positioner { --align-items: center; }
.modal[data-vertical="bottom"] .modal-positioner { --align-items: flex-end; }

.modal-panel {
    pointer-events: auto;
    opacity: 0;
    transform: translateY(10px) scale(75%);
    transition: 
        opacity var(--transition-duration, 300ms) var(--transition-timing, ease-in-out), 
        transform var(--transition-duration, 300ms) var(--transition-timing, ease-in-out);
}

.modal[data-state="open"] .modal-panel {
    opacity: 1;
    transform: translateY(0) scale(100%);
}
</style>

