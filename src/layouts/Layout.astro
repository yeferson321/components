---
import '@/styles/global.css';
import type { LocaleCode, Translation } from '@/i18n/config';

interface Props {
	locale: LocaleCode;
	translations: Translation;
};

const { locale, translations: t } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<!-- <ClientRouter /> -->
		<link rel="preconnect" href="https://challenges.cloudflare.com" />

		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<slot />


		<button id="test-modal-open">Open modal</button>

<div id="test-modal" class="test-modal">
    <div class="test-modal-overlay"></div>

    <div class="test-modal-panel">
        <h2>Test modal werfiojweorjfojweorjfoi</h2>
        <button id="test-modal-close">Close</button>
    </div>
</div>
	</body>
</html>

<script>
const modal = document.querySelector("#test-modal");
const panel = modal.querySelector(".test-modal-panel");

let isOpen = false;
let transitionVersion = 0;

const openModal = () => {
    if (isOpen) return;

    isOpen = true;
    transitionVersion++;

    modal.style.display = "grid";

    // Commit the initial styles before starting the transition.
    void modal.offsetWidth;

    requestAnimationFrame(() => {
        if (!isOpen) return;

        modal.classList.add("is-open");
    });
};

const closeModal = async () => {
    if (!isOpen) return;

    isOpen = false;
    const currentTransition = ++transitionVersion;

    modal.classList.remove("is-open");

    // Ensure the closing transition is registered.
    void panel.offsetWidth;

    const animations = modal.getAnimations({ subtree: true });

    await Promise.allSettled(
        animations.map((animation) => animation.finished)
    );

    // Prevent an old closing transition from hiding a reopened modal.
    if (transitionVersion !== currentTransition || isOpen) return;

    modal.style.display = "none";
};

document.querySelector("#test-modal-open").addEventListener("click", openModal);
document.querySelector("#test-modal-close").addEventListener("click", closeModal);
</script>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Figtree:wght@300..900&family=Righteous&display=swap');

.test-modal {
    position: fixed;
    inset: 0;
    display: none;
    place-items: center;
    pointer-events: none;
}

.test-modal.is-open {
    pointer-events: auto;
}

.test-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 50%);
    opacity: 0;
    transition: opacity 600ms ease;
}

.test-modal-panel {
    position: relative;
    padding: 40px;
    background: white;
    border-radius: 16px;
    opacity: 0;
    transform: translateY(10px) scale(0.75);
    transition:
        opacity 600ms ease,
        transform 600ms ease;
}

.test-modal.is-open .test-modal-overlay {
    opacity: 1;
}

.test-modal.is-open .test-modal-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
}
</style>

