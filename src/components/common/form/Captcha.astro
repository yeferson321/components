---
import type { Translation } from '@/i18n/config';
import { CaptchaOrder, CaptchaSlider, FormField, Modal } from 'ui/components';
import { IconChevronRight, IconShieldCheck, IconXmark } from 'ui/icons/outline';

interface Props {
    id: string;
    translations: Translation.Captcha;
};

const { id, translations: t } = Astro.props;
---

<FormField>

    <div class="login-captcha" data-captcha-id={id}>

        <button type="button" class="group flex justify-between w-full h-13 items-center gap-2 px-4 border rounded-2xl border-neutral-200/70 bg-neutral-100 text-neutral-600 transition-colors duration-300 disabled:cursor-not-allowed disabled:pointer-events-none" data-modal-open={`${id}-captcha-modal`} aria-label={t.ariaLabel.openModal} aria-haspopup="dialog" aria-expanded="false" aria-controls={`${id}-captcha-modal`}>
            
            <div class="flex items-center gap-2">
                <span class="w-6 h-6 flex items-center justify-center border rounded-md border-neutral-600 group-data-[verified=true]:border-emerald-700 bg-white" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" width="18" height="18" stroke="currentColor" class="hidden group-data-[verified=true]:flex group-data-[verified=true]:stroke-emerald-700">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg>
                </span>
                <span class="text-base text-neutral-600">{t.label}</span>
            </div>
        
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 stroke-emerald-700">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
        
        </button>

        <input id={id} type="checkbox" class="sr-only" name="captcha" data-field-input data-validate="checkbox" tabindex="-1" aria-hidden="true" required>

    </div>

</FormField>

<Modal id={`${id}-captcha-modal`} verticalPosition="center" overlayColor="rgba(0,0,0,0.5)" offset="2rem" unmount={true}>
   
    <div class="px-8 pt-12 pb-8 sm:my-8 sm:w-full sm:max-w-lg rounded-3xl border border-neutral-200/70 bg-white">
        <CaptchaSlider id={`${id}-captcha-slider`}>
            <div class="space-y-3">
                <div>
                    <div class="flex items-center text-emerald-700">
                        <IconShieldCheck stroke-width="1.6" width="16" height="16" class="shrink-0 me-1" aria-hidden="true"/>
                        <span class="text-base">{t.protected}</span>
                    </div>
                    <h2 class="text-lg text-neutral-600">{t.instruction}</h2>
                </div>
            
                <div class="relative h-37 overflow-hidden rounded-2xl bg-blue-100">
                    <svg viewBox="0 0 446 150" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 size-full" aria-hidden="true">
                        <circle cx="70" cy="40" r="26" fill="#bfdbfe"/>
                        <path d="M0 150L110 70L200 150Z" fill="#93c5fd"/>
                        <path d="M140 150L270 50L400 150Z" fill="#60a5fa" opacity=".7"/>
                        <circle cx="380" cy="36" r="16" fill="#fde68a"/>
                    </svg>
                
                    <div class="absolute top-13 box-border size-11 rounded-lg border-2 border-dashed border-white bg-black/30" data-captcha-hole></div>
                
                    <div class="captcha-piece absolute top-13 box-border size-11 rounded-lg border-2 border-white shadow-md bg-blue-500" data-captcha-piece></div>
                </div>
            
                <div class="relative h-11 rounded-full bg-neutral-100 ring-1 ring-neutral-300" data-captcha-track>
                    <div class="captcha-fill absolute inset-y-0 left-0 rounded-full opacity-25 bg-blue-500" data-captcha-fill></div>
                
                    <button type="button" class="absolute top-0 flex size-11 touch-none cursor-grab items-center justify-center rounded-full border border-neutral-400 bg-white shadow-sm" data-captcha-handle aria-label={t.ariaLabel.slider}>
                        <IconChevronRight stroke-width="1.8" width="20" height="20" class="stroke-neutral-600" />
                    </button>
                </div>
            
                <p role="status" aria-live="polite" class="captcha-status flex min-h-5 items-center gap-2 text-sm text-neutral-600">
                    <span class="size-2 shrink-0 rounded-full bg-current" aria-hidden="true"></span>
                    <span data-captcha-status data-messages={JSON.stringify(t.messages)}>{t.messages.idle}</span>
                </p>
            </div>
        </CaptchaSlider>

        <button type="button" class="absolute top-4 inset-e-7" data-modal-close={`${id}-captcha-modal`} aria-label={t.ariaLabel.closeModal}>
	    	<IconXmark stroke-width="1.8" width="28" height="28" class="stroke-neutral-600"/>
	    </button>
    </div>

</Modal>

<style is:global>
.captcha[data-captcha="error"] .captcha-piece, .captcha[data-captcha="error"] .captcha-fill {
    background-color: oklch(75% 0.183 55.934);
}

.captcha[data-captcha="error"] .captcha-status {
    color: oklch(75% 0.183 55.934);
}

.captcha[data-captcha="verified"] .captcha-piece, .captcha[data-captcha="verified"] .captcha-fill {
    background-color: oklch(50.8% 0.118 165.612);
}

.captcha[data-captcha="verified"] .captcha-status {
    color: oklch(50.8% 0.118 165.612);
}
</style>

<script>
    const setupLoginCaptcha = (fieldElement: HTMLDivElement) => {
        const id = fieldElement.dataset.captchaId!;

        const openModalButtonElement = fieldElement.querySelector<HTMLButtonElement>("[data-modal-open]");
        const inputCaptchaElement = fieldElement.querySelector<HTMLInputElement>('input[type="checkbox"]');
        
        if (!inputCaptchaElement || !openModalButtonElement) return;
       
        const captchaField = inputCaptchaElement?.closest<HTMLDivElement & { validate?: () => unknown }>('.form-field');
          
        const setVerified = (verified: boolean) => {
            inputCaptchaElement.checked = verified;
            openModalButtonElement.dataset.verified = String(verified);
            openModalButtonElement.disabled = verified; // ya verificado: no hace falta reabrir el modal

            captchaField?.validate?.();
        };

        // sin el elemento, por id

        // document.querySelector('.modal')?.addEventListener('modal:change', (event) => {
        //     console.log(event.detail.isOpen);
        // });

        // document.querySelector<HTMLElement>('.modal')?.addEventListener('modal:change', (event) => {
        //     console.log(event.detail.isOpen); // ahora sí
        // });

        // window.addEventListener(`modal:change:${id}-captcha-modal`, (event) => {
        //     console.log(event.detail.isOpen); // ahora sí
        // }); 

        window.addEventListener(`captcha:change:${id}-captcha-slider`, (event) => {
            const { state } = event.detail;

            if (state === 'verified') {
                window.dispatchEvent(new Event(`modal:hide:${id}-captcha-modal`));
                setTimeout(() =>  setVerified(true), 300);
                return;
            }  
            
            if (state === 'idle') setVerified(false);
        });
    };
    
    document.querySelectorAll<HTMLDivElement>(".login-captcha").forEach(setupLoginCaptcha);
</script>
