---
import type { ValidatorKey } from 'ui/behaviors';
import { FormField } from 'ui/components';
import Feedback from '@/components/common/form/Feedback.astro';

interface Props extends astroHTML.JSX.InputHTMLAttributes {
    id: string;
    label?: string;
    messages?: Record<string, string>;
    validate: ValidatorKey;
};

const { id, type, label, messages = {}, validate, ...inputAttributes } = Astro.props;
---

<FormField>

    <div class="relative">
        
        <input id={id} type={type} class="field-input peer block w-full h-13 px-4 border rounded-2xl border-neutral-600 text-lg text-neutral-600 bg-transparent transition-colors duration-300 focus:border-blue-500 focus:outline-none" placeholder=" " {...inputAttributes} data-field-input data-validate={validate}/>
        
        <label for={id} class="field-label absolute left-3 px-1 pointer-events-none duration-300 top-0 -translate-y-1/2 text-base text-neutral-600 bg-white
            peer-placeholder-shown:top-1/2
            peer-placeholder-shown:-translate-y-1/2
            peer-placeholder-shown:text-lg
            peer-placeholder-shown:bg-transparent
            peer-focus:top-0
            peer-focus:-translate-y-1/2
            peer-focus:text-base
            peer-focus:text-blue-500
            peer-focus:bg-white">
            {label}
        </label>
        
    </div>

    <Feedback type="field" messages={messages} />

</FormField>

<style is:global>
.form-field[data-state="valid"] .field-input {
    border-color: oklch(50.8% 0.118 165.612);
}

.form-field[data-state="invalid"] .field-input,
.form-field[data-state="error"] .field-input {
    border-color: oklch(75% 0.183 55.934);
}

.form-field[data-state="valid"] .field-label {
    color: oklch(50.8% 0.118 165.612);
}

.form-field[data-state="invalid"] .field-label,
.form-field[data-state="error"] .field-label {
    color: oklch(75% 0.183 55.934);
}

input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:active {
    /* Esto simula el background-color real usando un box-shadow enorme */
    -webkit-box-shadow: 0 0 0 1000px oklch(100% 0 0) inset !important;
    box-shadow: 0 0 0 1000px oklch(100% 0 0) inset !important;
    /* El color del texto sí puedes forzarlo directamente */
    -webkit-text-fill-color: oklch(43.9% 0 0) !important;
    caret-color: oklch(43.9% 0 0);
    /* Evita el "flash" del color por defecto al cargar */
    transition: background-color 5000s ease-in-out 0s;
}
</style>