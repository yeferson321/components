---
import { IconInformationCircle } from 'ui/icons/outline';

interface Props {
	type: "form" | "field";
    messages?: Record<string, string>;
};

const { type, messages } = Astro.props;
---

<div class:list={['feedback mx-2', `${type}-feedback`]}>
    <div class="flow-root text-sm text-orange-400">
        <IconInformationCircle stroke-width="1.6" width="14" height="14" class="float-left shrink-0 me-1 mt-0.5" aria-hidden="true" />
        <span aria-live="polite" data-feedback={type} data-messages={JSON.stringify(messages)}></span>
    </div>
</div>

<style is:global>
.feedback {
    display: none;
}

.form-field[data-state="invalid"] .feedback,
.form-field[data-state="error"] .feedback {
    display: flex;
}

.feedback:has([data-feedback="form"][data-state="invalid"]) {
    display: flex;
}
</style>
