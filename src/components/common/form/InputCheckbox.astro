---
import { FormField } from 'ui/components';
import Feedback from '@/components/common/form/Feedback.astro';

interface Props extends astroHTML.JSX.InputHTMLAttributes {
    label: string;
    messages?: Record<string, string>;
};

const { id, label, messages = {}, ...inputAttributes } = Astro.props;
---

<FormField>

    <div class="mx-2 flex">
        <input id={id} type="checkbox" class="field-input me-1.5" {...inputAttributes} data-field-input data-validate="checkbox" />

        <label for={id} class="text-sm text-neutral-600">{label}</label>
    </div>

    <Feedback type="field" messages={messages} />

</FormField>

<style>
input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    border: 1px solid oklch(43.9% 0 none);
    border-radius: 6px;
    background-color: transparent;
    cursor: pointer;
    display: inline-grid;
    place-content: center;
    flex-shrink: 0;
}

input[type="checkbox"]::before {
    content: "";
    width: 6px;
    height: 11px;
    border: solid #ffffff;
    border-width: 0 2px 2px 0;
    transform: translateY(-1px) rotate(45deg) scale(0);
    transition: transform 150ms ease-in-out;
}

input[type="checkbox"]:checked {
    border-color: oklch(50.8% 0.118 165.612);
    background-color: oklch(50.8% 0.118 165.612);
}

input[type="checkbox"]:checked::before {
    transform: translateY(-1px) rotate(45deg) scale(1);
}

input[type="checkbox"]:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
</style>