---
import type { Translation } from '@/i18n/config';
import type { ValidatorKey } from 'ui/behaviors';
import { FormField, ToggleButton } from 'ui/components';
import Feedback from '@/components/common/form/Feedback.astro';
import { IconCheckCircle, IconEye, IconEyeSlash } from 'ui/icons/outline';

interface Props extends astroHTML.JSX.InputHTMLAttributes {
    validate: ValidatorKey;
    translations: Translation.SignUpForm["form"]["fields"]["newPassword"] | Translation.SignInForm["form"]["fields"]["currentPassword"];
};

const { id, type, validate, translations, ...inputAttributes } = Astro.props;
---

<FormField>

    <div class="relative">
        
        <input id={id} type={type} class="field-input peer block w-full h-13 px-4 border rounded-2xl border-neutral-600 text-lg text-neutral-600 bg-transparent transition-colors duration-300 focus:border-blue-500 focus:outline-none" placeholder=" " {...inputAttributes} data-field-input data-validate={validate}/>
        
        <label for={id} class="field-label absolute left-3 px-1 pointer-events-none duration-300 top-0 -translate-y-1/2 text-base text-neutral-600 bg-white
            peer-placeholder-shown:top-1/2
            peer-placeholder-shown:-translate-y-1/2
            peer-placeholder-shown:text-lg
            peer-placeholder-shown:bg-transparent
            peer-focus:top-0
            peer-focus:-translate-y-1/2
            peer-focus:text-base
            peer-focus:text-blue-500
            peer-focus:bg-white">
            {translations.label}
        </label>

        <ToggleButton id={`${id}-toggle-button`} class="absolute right-4 top-1/2 -translate-y-1/2" ariaLabelActive={translations.ariaLabel.hidePassword} ariaLabelInactive={translations.ariaLabel.showPassword}>
            <IconEye stroke-width="1.6" width="20" height="20" class="stroke-neutral-600 hidden" data-toggle-button-active />
            <IconEyeSlash stroke-width="1.6" width="20" height="20" class="stroke-neutral-600" data-toggle-button-inactive/>
        </ToggleButton>

    </div>

    <Feedback type="field" messages={translations.validation} />

    { "passwordRules" in translations && (
        <div class="mx-2 mt-2 space-y-1 password-rules">

            <p class="text-sm text-neutral-600">{translations.passwordRules.title}</p>

            <span class="flex items-start gap-1 text-sm text-neutral-600 transition-colors duration-300 ease-in-out" data-requirement="letter">
                <IconCheckCircle stroke-width="1.6" width="18" height="18" class="stroke-current shrink-0"/>
                {translations.passwordRules.rules.letter}
            </span>

            <span class="flex items-start gap-1 text-sm text-neutral-600 transition-colors duration-300 ease-in-out" data-requirement="number">
                <IconCheckCircle stroke-width="1.6" width="18" height="18" class="stroke-current shrink-0"/>
                {translations.passwordRules.rules.number}
            </span>

            <span class="flex items-start gap-1 text-sm text-neutral-600 transition-colors duration-300 ease-in-out" data-requirement="special">
                <IconCheckCircle stroke-width="1.6" width="18" height="18" class="stroke-current shrink-0"/>
                {translations.passwordRules.rules.special}
            </span>

            <span class="flex items-start gap-1 text-sm text-neutral-600 transition-colors duration-300 ease-in-out" data-requirement="length">
                <IconCheckCircle stroke-width="1.6" width="18" height="18" class="stroke-current shrink-0"/>
                {translations.passwordRules.rules.length}
            </span>

        </div>
    )}

</FormField>

<script>
    const setupPasswordVisibility = (fieldElement: HTMLDivElement) => { 
        const passwordInput = fieldElement.querySelector<HTMLInputElement>('input[type="password"]');
        const toggleButton = fieldElement.querySelector<HTMLButtonElement>('[id$="-toggle-button"]');

        toggleButton?.addEventListener("toggle-button:change", (event) => {
            const { active } = (event as CustomEvent<{ active: boolean }>).detail;
            if (passwordInput) passwordInput.type = active ? "text" : "password";
        });
    };
    
    document.querySelectorAll<HTMLDivElement>(".form-field").forEach(setupPasswordVisibility);
</script>

<style is:global>
.form-field[data-state="valid"] .field-input {
    border-color: oklch(50.8% 0.118 165.612);
}

.form-field[data-state="invalid"] .field-input,
.form-field[data-state="error"] .field-input {
    border-color: oklch(75% 0.183 55.934);
}

.form-field[data-state="valid"] .field-label {
    color: oklch(50.8% 0.118 165.612);
}

.form-field[data-state="invalid"] .field-label,
.form-field[data-state="error"] .field-label {
    color: oklch(75% 0.183 55.934);
}

input:-webkit-autofill,
input:-webkit-autofill:hover,
input:-webkit-autofill:focus,
input:-webkit-autofill:active {
    /* Esto simula el background-color real usando un box-shadow enorme */
    -webkit-box-shadow: 0 0 0 1000px oklch(100% 0 0) inset !important;
    box-shadow: 0 0 0 1000px oklch(100% 0 0) inset !important;
    /* El color del texto sí puedes forzarlo directamente */
    -webkit-text-fill-color: oklch(43.9% 0 0) !important;
    caret-color: oklch(43.9% 0 0);
    /* Evita el "flash" del color por defecto al cargar */
    transition: background-color 5000s ease-in-out 0s;
}

.form-field[data-req-letter="true"] [data-requirement="letter"],
.form-field[data-req-number="true"] [data-requirement="number"],
.form-field[data-req-special="true"] [data-requirement="special"],
.form-field[data-req-length="true"] [data-requirement="length"] {
    color: oklch(50.8% 0.118 165.612);
}

.form-field[data-state="error"] [data-requirement] {
    color: oklch(43.9% 0 0) !important;
}
</style>