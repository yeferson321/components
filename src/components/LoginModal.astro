---
import type { Translation } from '@/i18n/config';
import { Modal, MultiStep } from 'ui/components';
// import MultiStep from '@/components/common/MultiStep.astro';

import SignInForm from './auth/forms/SignInForm.astro';
import SignUpForm from './auth/forms/SignUpForm.astro';
import { IconXmark } from 'ui/icons/outline';
import { IconGoogle, IconX } from 'ui/icons/brands';

interface Props {
	translations: Translation;
};

const { translations: t } = Astro.props;
---

<Modal id="login-modal" verticalPosition="center" overlayColor="rgba(0,0,0,0.5)" offset="2rem" unmount={true}>
					
    <div class="px-8 pt-12 pb-8 sm:my-8 sm:w-full sm:max-w-lg rounded-3xl border border-neutral-200/70 bg-white">

		<img src="https://cdn.pixabay.com/photo/2023/12/03/21/33/butterfly-8428277_1280.jpg" alt="OnlyPacks Logo" class="mx-auto w-full h-20"/>

		<MultiStep unmount={true}>

			<div data-multistep-view="sign-in" data-active="false">
				<SignInForm tSignIn={t.home.loginModal.signIn} tCaptcha={t.common.captcha}/>
			</div>
			
			<div data-multistep-view="sign-up" data-active="true">
				<SignUpForm tSignUp={t.home.loginModal.signUp} tCaptcha={t.common.captcha}/>
			</div>

		</MultiStep>

		<p class="mt-6 text-center text-base text-neutral-800">{t.home.loginModal.social.title}</p>
					
        <div class="mt-4 space-y-4">

        	<button class="w-full flex justify-center items-center gap-3 h-12 px-4 rounded-3xl border border-neutral-200/70 bg-neutral-100" aria-label={t.home.loginModal.social.google.ariaLabel}>
        	    <IconGoogle width="20" height="20"/>
				<span class="text-base font-medium text-neutral-600">{t.home.loginModal.social.google.text}</span>
        	</button>
						
        	<button class="w-full flex justify-center items-center gap-3 h-12 px-4 rounded-3xl border border-neutral-200/70 bg-neutral-100" aria-label={t.home.loginModal.social.x.ariaLabel}>
        	    <IconX width="20" height="20"/>
				<span class="text-base font-medium text-neutral-600">{t.home.loginModal.social.x.text}</span>
        	</button>

        </div>

		<p class="mt-6 text-center text-sm text-neutral-800">
            {t.home.loginModal.terms.text} <a href="/terms" class="underline font-medium">{t.home.loginModal.terms.termsOfUse}</a> • <a href="/privacy" class="underline font-medium">{t.home.loginModal.terms.privacyPolicy}</a>
        </p>
	
		<button type="button" class="absolute top-4 inset-e-7" data-modal-close="login-modal" aria-label={t.home.loginModal.close.ariaLabel}>
			<IconXmark stroke-width="1.8" width="28" height="28" class="stroke-neutral-600"/>
		</button>
					
    </div>

</Modal>

<style>

</style>


