---
import LoginModal from '@/components/auth/LoginModal.astro';
import IconHeart from '@/icons/outline/IconHeart.svg';

interface Props {
	translations: any;
	locale: string;
};

const { translations, locale } = Astro.props;
---

<button type="button" class="p-2.5 rounded-full bg-blue-500/20 hover:bg-blue-500/30 transition-colors duration-300 ease-in-out" data-modal-open="login-modal" aria-label="Abrir modal de inicio de sesión" aria-haspopup="dialog" aria-expanded="false" aria-controls="login-modal">
	<IconHeart stroke-width="2" width="26" height="26" class="stroke-blue-500"/>
</button>

<LoginModal translations={translations.loginModal}/>