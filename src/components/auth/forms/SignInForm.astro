---
import type { Translation } from '@/i18n/config';
import { createApiToken } from '@/lib/jwt';
import { fieldLimits } from 'ui/behaviors';
import { ToggleButton } from 'ui/components';
import { IconLoad } from 'ui/icons/solid';
import Input from '@/components/common/form/Input.astro';
import InputPassword from '@/components/common/form/InputPassword.astro';
import InputCheckbox from '@/components/common/form/InputCheckbox.astro';
import InputCaptcha from '@/components/common/form/InputCaptcha.astro';
import Feedback from '@/components/common/form/Feedback.astro';

interface Props {
	translations: Translation.SignInForm;
};

const { translations } = Astro.props;

const apiToken = await createApiToken(import.meta.env.API_KEY, import.meta.env.JWT_ENCRYPTION_KEY);
---

<h2 id="signin-modal-title" class="text-center text-2xl font-medium text-neutral-800">{translations.title}</h2>

<p class="mt-2 text-center text-base text-neutral-800">
    {translations.subtitle.text} 
    <button type="button" class="ms-1 underline text-neutral-600 font-medium" data-multistep-target="signin-in" aria-label="">
        {translations.subtitle.action}
    </button>
</p>

<form id="signin-form" class="mt-6 space-y-4" data-api-token={apiToken}>

    <Input id="signin-email" type="email" name="email" autocomplete="email" spellcheck="false" validate="email"
        minlength={fieldLimits.email.minLength} maxlength={fieldLimits.email.maxLength}
        label={translations.form.fields.email.label} messages={translations.form.fields.email.validation} required
    />

    <InputPassword id="signin-password" type="password" name="password" autocomplete="current-password" validate="current-password"
        minlength={fieldLimits.password.minLength} maxlength={fieldLimits.password.maxLength} translations={translations.form.fields.newPassword} required
    />

    <InputCaptcha id="signin-captcha-slider" translations={translations.form.fields.captcha}/>

    <!-- <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}></div> -->

    <Feedback type="form" messages={translations.form.error} />

    <ToggleButton id="signin-submit" type="submit" class="w-full h-11 px-4 rounded-3xl text-white flex items-center justify-center bg-blue-500 transition-opacity duration-300 ease-in-out disabled:opacity-70 disabled:cursor-not-allowed disabled:pointer-events-none" ariaLabelActive="Enviando formulario" ariaLabelInactive="Enviar formulario" mode="busy" disabled>

        <IconLoad class="size-8 hidden" data-toggle-button-active/>
    
        <span class="text-lg font-medium" data-toggle-button-inactive>{translations.form.actions.submit}</span>

    </ToggleButton>
        			    
</form>

<script>
    import { actions } from 'astro:actions';
    import { setupForm } from 'ui/behaviors';

    type SignUpForm = {
        name: string;
        email: string;
        password: string;
        terms?: string;
        captcha?: string;
    };

    const form = document.getElementById('signup-form') as HTMLFormElement | null;
    const apiToken = form?.dataset.apiToken;

    const resetForm = () => {
        window.dispatchEvent(new CustomEvent('toggle-button:deactivate:signup-submit'));
        window.dispatchEvent(new CustomEvent('captcha:reset:signup-captcha-slider'));
    };
   
    if (form) {
        
        const { setFieldsError, setFormError } = setupForm<SignUpForm>(form, async (data) => {

            const response = await fetch('/api/auth/register', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    "Authorization": `Bearer ${apiToken}`,
                },
                body: JSON.stringify({ ...data }),
            });

            if (!response.ok) {
                if (response.status === 409) {
                    setFieldsError({ email: 'CONFLICT' });
                } else {
                    setFormError('INTERNAL_SERVER_ERROR');
                }

                resetForm();
                return;
            }

            window.location.href = '/profile';
        });
    }

    // if (form) {
    //     const { setFieldsError, setFormError } = setupForm<SignUpForm>(form, async (data) => {

    //         const { error } = await actions.register(data);

    //         console.log("error completo:", error);

    //         if (error) {
                
    //             if (error.code === "CONFLICT") {
    //                 setFieldsError({ email: "CONFLICT" });
    //             } else {
    //                 setFormError("INTERNAL_SERVER_ERROR");
    //             }

    //             window.dispatchEvent(new CustomEvent("toggle-button:deactivate:signup-submit"));
    //             return;
    //         }

    //         window.location.href = "/profile";
    //     });
    // }
</script>