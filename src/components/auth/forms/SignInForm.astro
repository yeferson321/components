---
import type { Translation } from '@/i18n/config';
import Input from '@/components/common/Input.astro';

interface Props {
	translations: Translation.SignInForm;
};

const { translations } = Astro.props;
---

<h2 id="login-modal-title" class="text-center text-2xl font-medium text-neutral-800">{translations.title}</h2>

<p class="mt-2 text-center text-base text-neutral-800">{translations.subtitle.text} <button type="button" class="underline text-neutral-600 font-medium" data-multistep-target="sign-up" aria-label="">{translations.subtitle.action}</button></p>

<form id="signin-form" class="mt-6 space-y-4"> 

    <Input type="email" name="email" autocomplete="email" minlength={6} maxlength={120} required={true} 
        label={translations.form.fields.email.label} 
        messages={translations.form.fields.email.validation}
    />

    <Input type="password" name="password" autocomplete="current-password" minlength={10} maxlength={64} required={true} 
        label={translations.form.fields.currentPassword.label} 
        messages={translations.form.fields.currentPassword.validation} 
        passwordToggle={{
            showLabel: translations.form.fields.currentPassword.ariaLabel.showPassword,
            hideLabel: translations.form.fields.currentPassword.ariaLabel.hidePassword
        }}
    />

    <div class="form-feedback mt-4 text-center text-sm text-red-500 hidden" data-form-feedback aria-live="polite"></div>

	<button type="submit" class="w-full p-2 rounded-3xl text-center text-lg font-medium text-white bg-blue-500 transition-opacity duration-300 ease-in-out disabled:opacity-80 disabled:cursor-not-allowed disabled:pointer-events-none" disabled>{translations.form.actions.submit}</button>
        			    
</form>

<script>
    import { actions } from "astro:actions";
    import { setupForm } from '@/components/common/form/formValidation';

    type SignInForm = {
        email: string;
        password: string;
    };

    const form = document.getElementById('signin-form') as HTMLFormElement | null;
    const formFeedback = form?.querySelector<HTMLElement>('[data-form-feedback]');

    if (form) {
        setupForm(form, async (data) => {
            // formFeedback?.classList.add('hidden');

            const { email, password } = data as SignInForm;

            // const { name, email, newPassword } = data as unknown as RegisterForm;

            console.log("formData", { email, password });
        });
    }
</script>

