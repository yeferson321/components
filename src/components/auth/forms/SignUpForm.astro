---
import type { Translation } from '@/i18n/config';
import { fieldLimits } from 'ui/behaviors';
import { ToggleButton } from 'ui/components';
import Input from '@/components/common/form/Input.astro';
import InputCheckbox from '@/components/common/form/InputCheckbox.astro';
import { IconCheckCircle, IconInformationCircle } from 'ui/icons/outline';
import Feedback from '@/components/common/form/Feedback.astro';
import { createApiToken } from '@/lib/jwt';

interface Props {
	translations: Translation.SignUpForm;
};

const { translations } = Astro.props;

const apiToken = await createApiToken(import.meta.env.API_KEY, import.meta.env.JWT_ENCRYPTION_KEY);

console.log("apiToken:", apiToken);
---

<h2 id="login-modal-title" class="text-center text-2xl font-medium text-neutral-800">{translations.title}</h2>

<p class="mt-2 text-center text-base text-neutral-800">{translations.subtitle.text} <button type="button" class="underline text-neutral-600 font-medium" data-multistep-target="sign-in" aria-label="">{translations.subtitle.action}</button></p>

<form id="signup-form" class="mt-6 space-y-4" data-api-token={apiToken}>

    <Input id="signup-email" type="email" name="email" autocomplete="email" spellcheck="false" validate="email"
        class="peer block w-full py-2.5 px-4 border rounded-2xl border-neutral-600 text-lg text-neutral-600 bg-transparent transition-colors duration-300 focus:border-blue-500 focus:outline-none" minlength={fieldLimits.email.minLength} maxlength={fieldLimits.email.maxLength}
        label={translations.form.fields.email.label} messages={translations.form.fields.email.validation} required
    />

    <Input id="signup-name" type="text" name="name" autocomplete="name" spellcheck="false" validate="name"
        class="peer block w-full py-2.5 px-4 border rounded-2xl border-neutral-600 text-lg text-neutral-600 bg-transparent transition-colors duration-300 focus:border-blue-500 focus:outline-none" minlength={fieldLimits.name.minLength} maxlength={fieldLimits.name.maxLength}
        label={translations.form.fields.name.label} messages={translations.form.fields.name.validation} required
    />

    <Input id="signup-password" type="password" name="password" autocomplete="new-password" validate="new-password"
        class="peer block w-full py-2.5 px-4 border rounded-2xl border-neutral-600 text-lg text-neutral-600 bg-transparent transition-colors duration-300 focus:border-blue-500 focus:outline-none" minlength={fieldLimits.password.minLength} maxlength={fieldLimits.password.maxLength}
        label={translations.form.fields.newPassword.label} messages={translations.form.fields.newPassword.validation} required
        passwordToggle={{
            showLabel: translations.form.fields.newPassword.ariaLabel.showPassword,
            hideLabel: translations.form.fields.newPassword.ariaLabel.hidePassword
        }}> 

        <div class="mx-2 mt-2 space-y-1 password-rules">
                
            <p class="text-sm text-neutral-600">{translations.form.fields.newPassword.passwordRules.title}</p>
                
            <span class="flex items-start gap-1 text-sm text-neutral-600 transition-colors duration-300 ease-in-out" data-requirement="letter">
                <IconCheckCircle stroke-width="1.6" width="18" height="18" class="stroke-current shrink-0"/>
                {translations.form.fields.newPassword.passwordRules.rules.letter}
            </span>
                
            <span class="flex items-start gap-1 text-sm text-neutral-600 transition-colors duration-300 ease-in-out" data-requirement="number">
                <IconCheckCircle stroke-width="1.6" width="18" height="18" class="stroke-current shrink-0"/>
                {translations.form.fields.newPassword.passwordRules.rules.number}
            </span>
                
            <span class="flex items-start gap-1 text-sm text-neutral-600 transition-colors duration-300 ease-in-out" data-requirement="special">
                <IconCheckCircle stroke-width="1.6" width="18" height="18" class="stroke-current shrink-0"/>
                {translations.form.fields.newPassword.passwordRules.rules.special}
            </span>
                
            <span class="flex items-start gap-1 text-sm text-neutral-600 transition-colors duration-300 ease-in-out" data-requirement="length">
                <IconCheckCircle stroke-width="1.6" width="18" height="18" class="stroke-current shrink-0"/>
                {translations.form.fields.newPassword.passwordRules.rules.length}
            </span>
                
        </div>

    </Input>

    <!-- <InputCheckbox id="signup-checkbox" name="terms" value="accepted" validate="checkbox"
        class="w-5 h-5 border rounded-full border-neutral-600"
        label="Confirmas que tienes al menos 18 años." messages={{ REQUIRED: "Debes confirmar que eres mayor de edad." }} required
    /> -->

    <Feedback type="form" messages={translations.form.error} />

    <ToggleButton id="signup-submit" type="submit" class="w-full h-11 px-4 rounded-3xl flex items-center justify-center text-white bg-blue-500 transition-opacity duration-300 ease-in-out disabled:opacity-70 disabled:cursor-not-allowed disabled:pointer-events-none" ariaLabelActive="Enviando formulario" ariaLabelInactive="Enviar formulario" mode="busy" disabled>

        <svg viewBox="0 0 48 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="size-8 hidden" data-toggle-button-active>
            <circle cx="8" cy="12" r="3" fill="currentColor">
                <animate attributeName="r" values="3;6;3" dur="1.2s" repeatCount="indefinite"/>
            </circle>
            <circle cx="24" cy="12" r="3" fill="currentColor">
                <animate attributeName="r" values="3;6;3" dur="1.2s" begin="0.2s" repeatCount="indefinite"/>
            </circle>
            <circle cx="40" cy="12" r="3" fill="currentColor">
                <animate attributeName="r" values="3;6;3" dur="1.2s" begin="0.4s" repeatCount="indefinite"/>
            </circle>
        </svg>
    
        <span class="text-lg font-medium" data-toggle-button-inactive>{translations.form.actions.submit}</span>

    </ToggleButton>
        			    
</form>

<script>
    import { actions } from 'astro:actions';
    import { setupForm } from 'ui/behaviors';

    type SignUpForm = {
        name: string;
        email: string;
        password: string;
        // terms?: string;
    };

    const form = document.getElementById('signup-form') as HTMLFormElement | null;
    const apiToken = form?.dataset.apiToken;

    if (form) {
        const { setFieldsError, setFormError } = setupForm<SignUpForm>(form, async (data) => {
            let res: Response;

            try {
                res = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        "Authorization": `Bearer ${apiToken}`,
                    },
                    body: JSON.stringify(data),
                });
            } catch {
                // error de red: el servidor no respondió
                setFormError('INTERNAL_SERVER_ERROR');
                window.dispatchEvent(new CustomEvent('toggle-button:deactivate:signup-submit'));
                return;
            }

            if (!res.ok) {
                if (res.status === 409) {
                    setFieldsError({ email: 'CONFLICT' });
                } else {
                    setFormError('INTERNAL_SERVER_ERROR');
                }

                window.dispatchEvent(new CustomEvent('toggle-button:deactivate:signup-submit'));
                return;
            }

            window.location.href = '/profile';
        });
    }

    // if (form) {
    //     const { setFieldsError, setFormError } = setupForm<SignUpForm>(form, async (data) => {

    //         const { error } = await actions.register(data);

    //         console.log("error completo:", error);

