    //                 setFieldsError({ email: "CONFLICT" });
    //             } else {
    //                 setFormError("INTERNAL_SERVER_ERROR");
    //             }

    //             window.dispatchEvent(new CustomEvent("toggle-button:deactivate:signup-submit"));
    //             return;
    //         }

    //         window.location.href = "/profile";
    //     });
    // }
</script>