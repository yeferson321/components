---
interface Props {
    class?: string;
};

const { class: className } = Astro.props;
---

<div class:list={["form-field", className]}>
    <slot />
</div>

<script>
    import type { FieldState, ValidatorKey, FormFieldElement } from '../behaviors/form/types';
    import { validators } from '../behaviors/form/inputValidation';
    import { getFeedback } from '../behaviors/feedback';
    import { debounce } from '../utils/limitExecution';
 
    const setupField = (fieldElement: FormFieldElement) => {
        const inputElement = fieldElement.querySelector<HTMLInputElement>("[data-field-input]");
        if (!inputElement) return;
 
        const { minLength, maxLength, required } = inputElement;
        const key = inputElement.dataset.validate as ValidatorKey | undefined;
        const validator = key ? validators[key] : undefined;
 
        if (!validator) {
            console.warn(`No hay validador registrado para data-validate="${key ?? ""}"`, inputElement);
            return;
        }
 
        const properties = { minLength, maxLength, required };
        const feedback = getFeedback(fieldElement.querySelector<HTMLElement>(`[data-feedback="field"]`));
 
        const validate = (): FieldState => {
            const { code, state, requirements } = validator({ value: inputElement.value, validity: inputElement.validity, properties });
 
            fieldElement.dataset.state = state;
            feedback?.show(code);
 
            if (requirements) {
                for (const [requirement, isValid] of Object.entries(requirements)) {
                    fieldElement.setAttribute(`data-req-${requirement}`, String(isValid));
                }
            }
 
            fieldElement.dispatchEvent(new CustomEvent("field:validated", { bubbles: true, detail: { state } }));
            return state;
        };
 
        // Expuestos en el DOM para que setupForm los use sin conocer setupField.
        fieldElement.validate = validate;
 
        fieldElement.setError = (code, fallbackMessage) => {
            fieldElement.dataset.state = "error";
            if (feedback?.get(code) !== undefined) return feedback?.show(code);
            if (fallbackMessage !== undefined) return feedback?.set(fallbackMessage);
            console.warn(`No hay traducción para el code de error "${code}"`, fieldElement);
            feedback?.show(code);
        };
 
        inputElement.addEventListener("input", debounce(validate, 400));
    };
 
    document.querySelectorAll<FormFieldElement>(".form-field").forEach(setupField);
</script>