---
interface Props {
    id?: string;
    class?: string;
};

const { id, class: className } = Astro.props;
---

<div id={id} class:list={["captcha", className]} data-captcha-type="order" data-captcha="idle">
    <slot />
</div>

<script>
    import { createCaptcha, type CaptchaElement } from './captcha';

    const SIZES = [24, 38, 52, 66]; // px, de la más pequeña a la más grande

    const setupOrder = (root: CaptchaElement) => {
        const items = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-captcha-item]'));
        if (items.length !== SIZES.length) throw new Error(`CaptchaOrder: se esperaban ${SIZES.length} elementos [data-captcha-item], se encontraron ${items.length}.`);

        let ranks: number[] = []; // ranks[slot] = posición correcta de esa figura (0 = la más pequeña)
        let taps: number[] = []; // slots tocados, en orden
        let timer = 0;

        const paint = (done = false) => {
            items.forEach((item, slot) => {
                const index = done ? ranks[slot] : taps.indexOf(slot);
                item.textContent = index >= 0 ? String(index + 1) : '';
                item.dataset.item = done ? 'done' : index >= 0 ? 'tapped' : '';
            });
        };

        const newRound = () => {
            ranks = [0, 1, 2, 3];
            for (let i = ranks.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [ranks[i], ranks[j]] = [ranks[j], ranks[i]];
            }
            taps = [];
            items.forEach((item, slot) => {
                item.style.width = `${SIZES[ranks[slot]]}px`;
                item.style.height = `${SIZES[ranks[slot]]}px`;
            });
            paint();
        };

        const captcha = createCaptcha(root, () => {
            clearTimeout(timer);
            newRound();
        });

        items.forEach((item, slot) => {
            item.addEventListener('click', () => {
                if (root.dataset.captcha !== 'idle' || taps.includes(slot)) return;

                taps.push(slot);
                paint();

                if (ranks[slot] !== taps.length - 1) {
                    item.dataset.item = 'wrong';
                    captcha.setState('error');
                    timer = window.setTimeout(() => root.reset?.(), 1100);
                } else if (taps.length === items.length) {
                    captcha.setState('verifying');
                    timer = window.setTimeout(() => {
                        paint(true);
                        captcha.setState('verified');
                    }, 400);
                }
            });
        });

        newRound();
    };

    document.querySelectorAll<CaptchaElement>('[data-captcha-type="order"]').forEach(setupOrder);
</script>