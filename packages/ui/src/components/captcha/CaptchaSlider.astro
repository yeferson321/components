---
interface Props {
    id?: string;
    class?: string;
};

const { id, class: className } = Astro.props;
---

<div id={id} class:list={["captcha", className]} data-captcha-type="slider" data-captcha-id={id} data-captcha="idle">
    <slot />
</div>

<style is:global>
.captcha {
    --r: 0;
    --t: 0.5;
    --captcha-handle-size: 0px; /* el script la fija con el tamaño real del handle */
}

.captcha :is([data-captcha-piece], [data-captcha-handle]) {
    left: calc((100% - var(--captcha-handle-size)) * var(--r));
}

.captcha [data-captcha-hole] {
    left: calc((100% - var(--captcha-handle-size)) * var(--t));
}

.captcha [data-captcha-fill] {
    width: calc((100% - var(--captcha-handle-size)) * var(--r) + var(--captcha-handle-size) / 2);
}

.captcha :is([data-captcha-piece], [data-captcha-hole], [data-captcha-handle], [data-captcha-fill]) {
    transition: left .3s ease, width .3s ease;
}

.captcha[data-dragging="true"] :is([data-captcha-piece], [data-captcha-fill], [data-captcha-handle]),
.captcha[data-captcha-measuring="true"] :is([data-captcha-piece], [data-captcha-hole], [data-captcha-handle], [data-captcha-fill]) {
    transition: none;
}
</style>

<script>
    type CaptchaState = 'idle' | 'verifying' | 'verified' | 'error';
 
    type CaptchaChangeDetail = { state: CaptchaState };
 
    declare global {
        interface HTMLElementEventMap {
            'captcha:change': CustomEvent<CaptchaChangeDetail>;
        }
 
        interface WindowEventMap {
            [key: `captcha:change:${string}`]: CustomEvent<CaptchaChangeDetail>;
        }
    }
 
    const TOLERANCE = 8; // px de margen para considerar que la pieza encajó
 
    const setupSlider = (captchaElement: HTMLElement) => {
        const { captchaId } = captchaElement.dataset;
        if (!captchaId) throw new Error('Missing "data-captcha-id" attribute on CaptchaSlider component');
 
        const trackElement = captchaElement.querySelector<HTMLElement>('[data-captcha-track]');
        if (!trackElement) throw new Error(`CaptchaSlider "${captchaId}": component internal element [data-captcha-track] not found.`);
 
        const handleElement = captchaElement.querySelector<HTMLButtonElement>('[data-captcha-handle]');
        if (!handleElement) throw new Error(`CaptchaSlider "${captchaId}": component internal element [data-captcha-handle] not found.`);
 
        captchaElement.dataset.captchaMeasuring = 'true';
 
        new ResizeObserver(([entry]) => {
            const width = entry.contentRect.width;
            if (width <= 0) return;
 
            captchaElement.style.setProperty('--captcha-handle-size', `${width}px`);
 
            if (captchaElement.dataset.captchaMeasuring) {
                requestAnimationFrame(() => { delete captchaElement.dataset.captchaMeasuring; });
            }
        }).observe(handleElement);
 
        let r = 0;
        let t = 0;
        let timer = 0;
 
        const maxPx = () => trackElement.clientWidth - handleElement.offsetWidth;
        const clamp = (value: number) => Math.min(1, Math.max(0, value));
        const paint = () => captchaElement.style.setProperty('--r', String(r));
        const locked = () => ['verifying', 'verified'].includes(captchaElement.dataset.captcha ?? '');
 
        const newRound = () => {
            t = 0.3 + Math.random() * 0.55;
            r = 0;
            captchaElement.style.setProperty('--t', String(t));
            paint();
        };
 
        const statusElement = captchaElement.querySelector<HTMLElement>('[data-captcha-status]');
        const messages: Record<string, string> = JSON.parse(statusElement?.dataset.messages ?? '{}');
        if (statusElement) delete statusElement.dataset.messages;
 
        const setState = (state: CaptchaState) => {
            if (captchaElement.dataset.captcha === state) return;
 
            captchaElement.dataset.captcha = state;
            if (statusElement) statusElement.textContent = messages[state] ?? '';
 
            const detail = { state };
            // captchaElement.dispatchEvent(new CustomEvent<CaptchaChangeDetail>('captcha:change', { bubbles: true, detail }));
            window.dispatchEvent(new CustomEvent<CaptchaChangeDetail>(`captcha:change:${captchaId}`, { detail }));
        };
 
        const reset = () => {
            clearTimeout(timer);
            newRound();
            setState('idle');
        };
 
        const finish = () => {
            if (Math.abs(r - t) * maxPx() <= TOLERANCE) {
                r = t;
                paint();
                setState('verifying');
                timer = window.setTimeout(() => setState('verified'), 400);
            } else {
                setState('error');
                timer = window.setTimeout(reset, 1100);
            }
        };
 
        handleElement.addEventListener('pointerdown', (event) => {
            const max = maxPx();
            if (locked() || max <= 0) return;
 
            clearTimeout(timer);
            if (captchaElement.dataset.captcha === 'error') reset();
 
            const startX = event.clientX;
            const startR = r;
            handleElement.setPointerCapture(event.pointerId);
            captchaElement.dataset.dragging = 'true';
 
            const move = (e: PointerEvent) => {
                r = clamp(startR + (e.clientX - startX) / max);
                paint();
            };
            const end = () => {
                handleElement.removeEventListener('pointermove', move);
                handleElement.removeEventListener('pointerup', end);
                handleElement.removeEventListener('pointercancel', end);
                captchaElement.dataset.dragging = 'false';
                finish();
            };
 
            handleElement.addEventListener('pointermove', move);
            handleElement.addEventListener('pointerup', end);
            handleElement.addEventListener('pointercancel', end);
        });
 
        // Teclado: flechas mueven la pieza, Enter confirma.
        handleElement.addEventListener('keydown', (event) => {
            if (locked()) return;
 
            if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
                event.preventDefault();
                if (captchaElement.dataset.captcha === 'error') reset();
                r = clamp(r + (event.key === 'ArrowRight' ? 0.02 : -0.02));
                paint();
            } else if (event.key === 'Enter') {
                event.preventDefault();
                finish();
            }
        });
 
        captchaElement.addEventListener('captcha:reset', reset);
        window.addEventListener(`captcha:reset:${captchaId}`, reset);
 
        newRound();
    };
 
    document.querySelectorAll<HTMLElement>('[data-captcha-type="slider"]').forEach(setupSlider);
</script>