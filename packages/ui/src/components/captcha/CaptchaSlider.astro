---
import { IconShieldCheck } from 'ui/icons/outline';

interface Props extends astroHTML.JSX.HTMLAttributes {
    class?: string;
    label: string;
    handleLabel: string;
    protectedLabel?: string;
    messages: Record<"idle" | "verifying" | "verified" | "error", string>;
};

const { class: className = "", label, handleLabel, protectedLabel, messages, ...attrs } = Astro.props;
---

<div class:list={["captcha", className]} data-captcha-type="slider" data-captcha="idle" {...attrs}>

    <div class="space-y-3">

        <div>

            <div class="flex items-center text-emerald-700"> 
                <IconShieldCheck stroke-width="1.6" width="16" height="16" class="shrink-0 me-1" aria-hidden="true"/>
                <span class="text-base">{protectedLabel}</span> 
            </div>
            
            <span class="text-lg text-neutral-600">{label}</span>

        </div>

        <div class="captcha-scene relative h-37 overflow-hidden rounded-2xl">
            <svg viewBox="0 0 446 150" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 size-full" aria-hidden="true">
                <circle cx="70" cy="40" r="26" fill="#bfdbfe"/>
                <path d="M0 150L110 70L200 150Z" fill="#93c5fd"/>
                <path d="M140 150L270 50L400 150Z" fill="#60a5fa" opacity=".7"/>
                <circle cx="380" cy="36" r="16" fill="#fde68a"/>
            </svg>
            <div class="absolute top-13 box-border size-11 rounded-lg border-2 border-dashed border-white bg-black/30" style="left: calc((100% - 44px) * var(--t))"></div>
            <div class="captcha-piece absolute top-13 box-border size-11 rounded-lg border-2 border-white shadow-md" style="left: calc((100% - 44px) * var(--r))"></div>
        </div>

        <div class="relative h-11 rounded-full bg-neutral-100 ring-1 ring-neutral-300" data-captcha-track>
            <div class="captcha-fill absolute inset-y-0 left-0 rounded-full opacity-25" style="width: calc((100% - 44px) * var(--r) + 22px)"></div>
            <button type="button" class="absolute top-0 flex size-11 touch-none cursor-grab items-center justify-center rounded-full border border-neutral-400 bg-white shadow-sm" style="left: calc((100% - 44px) * var(--r))" data-captcha-handle aria-label={handleLabel} >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neutral-600" aria-hidden="true">
                    <path d="M9 6l6 6-6 6"/>
                </svg>
            </button>
        </div>

        <p role="status" aria-live="polite" class="captcha-status flex min-h-5 items-center gap-2 text-sm text-neutral-600">
            <span class="size-2 shrink-0 rounded-full bg-current" aria-hidden="true"></span>
            <span data-captcha-status data-messages={JSON.stringify(messages)}>{messages.idle}</span>
        </p>

    </div>

</div>

<style>
    .captcha { --r: 0; --t: 0.5; }
    .captcha-scene { background: linear-gradient(135deg, #dbeafe, #f0f9ff); }
    .captcha-piece, .captcha-fill { background: oklch(62.3% 0.214 259.815); transition: left .3s, width .3s, background-color .3s; }
    [data-captcha-handle] { transition: left .3s; }
    .captcha[data-dragging="true"] :is(.captcha-piece, .captcha-fill, [data-captcha-handle]) { transition: none; }
    .captcha[data-captcha="verified"] .captcha-status { color: oklch(50.8% 0.118 165.612); }
    .captcha[data-captcha="verified"] :is(.captcha-piece, .captcha-fill) { background: oklch(50.8% 0.118 165.612); }
    .captcha[data-captcha="error"] .captcha-status { color: oklch(75% 0.183 55.934); }
    .captcha[data-captcha="error"] :is(.captcha-piece, .captcha-fill) { background: oklch(75% 0.183 55.934); }
</style>

<script>
    import { createCaptcha, type CaptchaElement } from './captcha';

    const TOLERANCE = 8; // px de margen para considerar que la pieza encajó

    const setupSlider = (root: CaptchaElement) => {
        const track = root.querySelector<HTMLElement>('[data-captcha-track]');
        const handle = root.querySelector<HTMLButtonElement>('[data-captcha-handle]');
        if (!track || !handle) return;

        // r = posición de la pieza y t = posición del hueco, ambas en proporción 0–1 del recorrido
        let r = 0;
        let t = 0;
        let timer = 0;

        const maxPx = () => track.clientWidth - handle.offsetWidth;
        const clamp = (value: number) => Math.min(1, Math.max(0, value));
        const paint = () => root.style.setProperty('--r', String(r));
        const locked = () => ['verifying', 'verified'].includes(root.dataset.captcha ?? '');

        const newRound = () => {
            t = 0.3 + Math.random() * 0.55;
            r = 0;
            root.style.setProperty('--t', String(t));
            paint();
        };

        const captcha = createCaptcha(root, () => {
            clearTimeout(timer);
            newRound();
        });

        const finish = () => {
            if (Math.abs(r - t) * maxPx() <= TOLERANCE) {
                r = t;
                paint();
                captcha.setState('verifying');
                timer = window.setTimeout(() => captcha.setState('verified'), 400);
            } else {
                captcha.setState('error');
                timer = window.setTimeout(() => root.reset?.(), 1100);
            }
        };

        handle.addEventListener('pointerdown', (event) => {
            const max = maxPx();
            if (locked() || max <= 0) return;

            clearTimeout(timer);
            if (root.dataset.captcha === 'error') root.reset?.();

            const startX = event.clientX;
            const startR = r;
            handle.setPointerCapture(event.pointerId);
            root.dataset.dragging = 'true';

            const move = (e: PointerEvent) => {
                r = clamp(startR + (e.clientX - startX) / max);
                paint();
            };
            const end = () => {
                handle.removeEventListener('pointermove', move);
                handle.removeEventListener('pointerup', end);
                handle.removeEventListener('pointercancel', end);
                root.dataset.dragging = 'false';
                finish();
            };

            handle.addEventListener('pointermove', move);
            handle.addEventListener('pointerup', end);
            handle.addEventListener('pointercancel', end);
        });

        // Teclado: flechas mueven la pieza, Enter confirma.
        handle.addEventListener('keydown', (event) => {
            if (locked()) return;

            if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
                event.preventDefault();
                if (root.dataset.captcha === 'error') root.reset?.();
                r = clamp(r + (event.key === 'ArrowRight' ? 0.02 : -0.02));
                paint();
            } else if (event.key === 'Enter') {
                event.preventDefault();
                finish();
            }
        });

        newRound();
    };

    document.querySelectorAll<CaptchaElement>('[data-captcha-type="slider"]').forEach(setupSlider);
</script>