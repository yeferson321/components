---
interface Props {
    class?: string;
    unmount?: boolean;
}

const { class: className = "", unmount = false, ...attributes } = Astro.props;
---

<div class:list={["multi-step", className]} data-unmount={String(unmount)} {...attributes}>
    <slot />
</div>

<script>
    import { appendChildElement, removeElement } from '#/utils/overlay';

    const setupMultiStep = (multiStepElement: HTMLDivElement) => {
        const shouldUnmount = multiStepElement.dataset.unmount === "true";

        // Se consultan ANTES de desmontar nada, así guardamos referencia a todas
        // las vistas y botones aunque luego salgan del DOM.
        const viewsElements = Array.from(
            multiStepElement.querySelectorAll<HTMLElement>("[data-multistep-view]")
        );
        const triggerbuttonsElements = multiStepElement.querySelectorAll<HTMLButtonElement>(
            "[data-multistep-target]"
        );

        const mountView = (viewElement: HTMLElement) => {
            if (!viewElement.isConnected) appendChildElement(viewElement, multiStepElement);
        };

        const unmountView = (viewElement: HTMLElement) => {
            if (viewElement.isConnected) removeElement(viewElement);
        };

        const changeView = (view: string) => {
            // Evita dejar el componente sin ninguna vista si el nombre no existe
            if (!viewsElements.some((el) => el.dataset.multistepView === view)) return;

            viewsElements.forEach((viewElement) => {
                const isActive = viewElement.dataset.multistepView === view;
                viewElement.dataset.active = String(isActive);
                viewElement.hidden = !isActive;

                if (!shouldUnmount) return;
                if (isActive) mountView(viewElement);
                else unmountView(viewElement);
            });
        };

        triggerbuttonsElements.forEach((button) => {
            button.addEventListener("click", () => {
                const view = button.dataset.multistepTarget;
                if (view) changeView(view);
            });
        });

        multiStepElement.addEventListener("multi-step:change", (event) => {
            const customEvent = event as CustomEvent<{ view: string }>;
            changeView(customEvent.detail.view);
        });

        // Estado inicial: si se desmonta, quitamos del DOM las vistas que no sean la activa
        if (shouldUnmount) {
            const initialView = viewsElements.find((el) => el.dataset.active === "true") ?? viewsElements[0];
            const initialName = initialView?.dataset.multistepView;
            if (initialName) changeView(initialName);
        }
    };

    document.querySelectorAll<HTMLDivElement>(".multi-step").forEach(setupMultiStep);
</script>

<style is:global>
.multi-step > * {
    display: none;
}

.multi-step > *[data-active="true"] {
    display: block;
}
</style>